// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id             String    @id @default(cuid())
  name           String    @unique
  currentMission Int       @default(1)
  credits        Int       @default(1000)
  totalScore     Int       @default(0)
  enemiesKilled  Int       @default(0)
  shipsDestroyed Int       @default(0)
  powerupsCollected Int    @default(0)
  totalFlightTime Int      @default(0) // in seconds
  difficulty     String    @default("soldier") // recruit, soldier, veteran, hero
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  missions       Mission[]
  ships          PlayerShip[]
  achievements   PlayerAchievement[]
}

model Mission {
  id            String    @id @default(cuid())
  playerId      String
  missionNumber Int
  completed     Boolean   @default(false)
  score         Int       @default(0)
  stars         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, missionNumber])
}

model Ship {
  id          String    @id @default(cuid())
  name        String
  description String
  shipType    String    // fighter, bomber, interceptor, etc.
  speed       Int       // 1-10
  firepower   Int       // 1-10
  health      Int       // 1-10
  cost        Int
  unlockMission Int     @default(1)

  playerShips PlayerShip[]
}

model PlayerShip {
  id        String    @id @default(cuid())
  playerId  String
  shipId    String
  purchased Boolean   @default(false)
  createdAt DateTime  @default(now())

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ship      Ship      @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([playerId, shipId])
}

model Achievement {
  id          String    @id @default(cuid())
  key         String    @unique // e.g., "first_blood", "ace_pilot"
  name        String
  description String
  icon        String    // emoji or asset path
  category    String    // combat, exploration, collection, etc.

  players     PlayerAchievement[]
}

model PlayerAchievement {
  id            String    @id @default(cuid())
  playerId      String
  achievementId String
  unlockedAt    DateTime  @default(now())

  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([playerId, achievementId])
}
